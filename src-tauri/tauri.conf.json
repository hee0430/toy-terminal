{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToyTerm",
  "version": "../package.json",
  "identifier": "com.toy.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "ToyTerm", "width": 1100, "height": 700, "minWidth": 600, "minHeight": 400, "dragDropEnabled": true,"decorations": false }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDQzZENEIxNDQ1NDU4RDAKUldUUVdGUkVzZFRHWFBvM3BkeTFPSTNONXhXSHhiS0dSSUZjaFA1UTZSNEpCYmpVdjl2aEVBMUoK",
      "endpoints": ["https://github.com/hee0430/toy-terminal/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
